# Browser (Vite exposes VITE_*; NEXT_PUBLIC_* kept for compatibility docs)
NEXT_PUBLIC_MIXPANEL_TOKEN=your_project_token
VITE_MIXPANEL_TOKEN=your_project_token

# Server-side tracking
MIXPANEL_TOKEN=your_project_token
MIXPANEL_PROJECT_TOKEN=your_project_token

# Import API / generate-data script
MIXPANEL_SERVICE_ACCOUNT_USERNAME=your_service_account_user
MIXPANEL_SERVICE_ACCOUNT_SECRET=your_service_account_secret
MIXPANEL_PROJECT_ID=your_project_id

# Aliases accepted by this repo (also used in .env)
# MIXPANEL_SERVICE_ACCOUNT_USER=
# MIXPANEL_SERVICE_ACCOUNT_PASS=
