DATABASE_URL=postgresql://cropguard:cropguard@127.0.0.1:5434/cropguard
SESSION_SECRET=change-me
NODE_ENV=development
PORT=5055

# CropGuard 2.0 optional
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=cropguard-dev
PAYMENT_PROVIDER=mock
WORKER_ENABLED=true
CLAIM_SETTLEMENT_HOURS=6
SEED_TOKEN=

# Mixpanel (never commit real secrets — use .env)
VITE_MIXPANEL_TOKEN=your_project_token
MIXPANEL_TOKEN=your_project_token
MIXPANEL_PROJECT_TOKEN=your_project_token
MIXPANEL_SERVICE_ACCOUNT_USERNAME=your_service_account_user
MIXPANEL_SERVICE_ACCOUNT_SECRET=your_service_account_secret
MIXPANEL_SERVICE_ACCOUNT_USER=your_service_account_user
MIXPANEL_SERVICE_ACCOUNT_PASS=your_service_account_secret
MIXPANEL_PROJECT_ID=your_project_id

